<Window x:Class="SportsRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SportsRecorder"
        xmlns:vm="clr-namespace:SportsRecorder.ViewModel"
        xmlns:m="clr-namespace:SportsRecorder.Model"
        xmlns:views="clr-namespace:SportsRecorder.Views"
        mc:Ignorable="d"
        Title="Sports Recorder" Height="450" Width="800">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- TreeView 樣式：移除邊距與邊框-->
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="#FF202020" />
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- TreeViewItem 樣式 -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="DFKai-SB"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <DataTemplate DataType="{x:Type vm:TrainingJournalViewModel}">
            <views:TrainingJournalView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CardioViewModel}">
            <views:CardioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StrengthViewModel}">
            <views:StrengthView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左側導覽 -->
        <Border Grid.Column="0">
            <TreeView ItemsSource="{Binding NavItems}"
                      SelectedItemChanged="TreeView_SelectedItemChanged">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type m:NavigationItem}"
                                              ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Title}" Padding="4,2" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <!-- 右側內容頁 -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>
    </Grid>
</Window>
