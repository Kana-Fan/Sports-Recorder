<Window x:Class="SportsRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SportsRecorder"
        xmlns:vm="clr-namespace:SportsRecorder.ViewModel"
        xmlns:m="clr-namespace:SportsRecorder.Model"
        xmlns:views="clr-namespace:SportsRecorder.Views"
        xmlns:wpf="clr-namespace:TitlebarAdaptive.WPF;assembly=TitlebarAdaptive.WPF"
        wpf:OriginalWindowHelper.Adaptive="False"
        wpf:OriginalWindowHelper.TitleBarIsLight="False"
        mc:Ignorable="d"
        Title="Sports Recorder"
        Icon="{DynamicResource Strength}"
        Height="700" Width="1000"
        MinHeight="700" MinWidth="1000"
        Closing="Window_Closing"
        Closed="Window_Closed"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <local:ResourceKeyToImageConverter x:Key="ResKeyToImg"/>
        <DataTemplate DataType="{x:Type vm:TrainingJournalViewModel}">
            <views:TrainingJournalView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CardioViewModel}">
            <views:CardioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StrengthViewModel}">
            <views:StrengthView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatsCardioViewModel}">
            <views:StatsCardioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatsStrengthViewModel}">
            <views:StatsStrengthView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DataManagementViewModel}">
            <views:DataManagementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HeatMapViewModel}">
            <views:HeatMapView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource NavBackgroundColor}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左側導覽 -->
        <Border Grid.Column="0"
                x:Name="NavPanel"
                Width="150"
                Background="{DynamicResource NavBackgroundColor}"
                ClipToBounds="True"
                BorderThickness="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Margin="10,28,10,10"
                        Click="ToggleNavButton_Click"
                        Style="{StaticResource MenuButton}">
                    <Image Source="{DynamicResource Menu}"
                           Style="{StaticResource ImageStyle}"/>
                </Button>

                <Rectangle Grid.Row="1" Style="{StaticResource DividerLine}"/>

                <TreeView Grid.Row="2"
                          x:Name="NavTreeView"
                          ItemsSource="{Binding NavItems}"
                          Style="{StaticResource TreeView}"
                          ItemContainerStyle="{StaticResource TreeViewItem}"
                          SelectedItemChanged="TreeView_SelectedItemChanged">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type m:NavigationItem}"
                                                  ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding IconKey, Converter={StaticResource ResKeyToImg}}"
                                        Style="{StaticResource MenuImageStyle}"/>

                                <TextBlock Text="{Binding Title}" Padding="4,2">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsNavCollapsed,
                                                             RelativeSource={RelativeSource AncestorType=TreeView}}"
                                                             Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <Rectangle Grid.Row="3" Style="{StaticResource DividerLine}"/>

                <Button Grid.Row="4"
                        x:Name="ChangeModeButton"
                        Click="ChangeModeButton_Click"
                        Style="{StaticResource MenuButton}">
                    <Image x:Name="Image"
                           Source="{DynamicResource Mode}"
                           Style="{StaticResource ImageStyle}"/>
                </Button>
            </Grid>
        </Border>

        <!-- 右側內容頁 -->
        <Border Grid.Column="1"
                Style="{StaticResource PageBorderStyle}">
            <ContentControl Content="{Binding CurrentPage}" />
        </Border>
    </Grid>
</Window>
