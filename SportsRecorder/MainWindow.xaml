<Window x:Class="SportsRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SportsRecorder"
        xmlns:vm="clr-namespace:SportsRecorder.ViewModel"
        xmlns:m="clr-namespace:SportsRecorder.Model"
        xmlns:views="clr-namespace:SportsRecorder.Views"
        xmlns:wpf="clr-namespace:TitlebarAdaptive.WPF;assembly=TitlebarAdaptive.WPF"
        wpf:OriginalWindowHelper.Adaptive="False"
        wpf:OriginalWindowHelper.TitleBarIsLight="False"
        mc:Ignorable="d"
        Title="Sports Recorder"
        Icon="/Assets/Icons/fitness_121040.ico"
        Height="800" Width="1000"
        MinHeight="800" MinWidth="1000">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:TrainingJournalViewModel}">
            <views:TrainingJournalView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CardioViewModel}">
            <views:CardioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StrengthViewModel}">
            <views:StrengthView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatsCardioViewModel}">
            <views:StatsCardioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatsStrengthViewModel}">
            <views:StatsStrengthView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DataManagementViewModel}">
            <views:DataManagementView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#1A1D27" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左側導覽 -->
        <Border Grid.Column="0"
                x:Name="NavPanel"
                Width="150"
                Margin="10,0,0,0"
                ClipToBounds="True"
                BorderThickness="0,0,2,0" BorderBrush="Black">
            <StackPanel>
                <Button x:Name="ToggleNavButton"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="0,10,0,0"
                        Width="40" Height="40"
                        Click="ToggleNavButton_Click"
                        Panel.ZIndex="10"
                        Style="{StaticResource PrimaryButton}">
                    <Image Source="/Assets/Icons/menu.png"
                           Width="30" Height="30"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <TreeView x:Name="NavTreeView"
                      ItemsSource="{Binding NavItems}"
                      SelectedItemChanged="TreeView_SelectedItemChanged">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type m:NavigationItem}"
                                              ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding IconPath}"
                                    Width="20" Height="20"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding Title}" Padding="4,2"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            </StackPanel>
        </Border>

        <!-- 右側內容頁 -->
        <ContentControl Grid.Column="1" Background="#1A1D27" Content="{Binding CurrentPage}"/>
    </Grid>
</Window>
