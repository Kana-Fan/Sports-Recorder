<UserControl x:Class="SportsRecorder.Views.StatsStrengthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SportsRecorder.Views"
             xmlns:vm="clr-namespace:SportsRecorder.ViewModel"
             xmlns:services="clr-namespace:SportsRecorder.Services"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:helpers="clr-namespace:SportsRecorder.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="1000" d:DesignWidth="800">
    <Grid Margin="0,0,0,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Source="{DynamicResource Stats}" Style="{StaticResource TitleImageStyle}"/>
            <TextBlock Text="統計圖表 - 重量訓練" Style="{StaticResource Title}" />
            <Image Source="{DynamicResource Strength}" Style="{StaticResource TitleImageStyle}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="50" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Rectangle Grid.Row="0" Grid.ColumnSpan="5" Style="{StaticResource TitleDividerLine}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="起始日期" Style="{StaticResource Subheading}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="結束日期" Style="{StaticResource Subheading}"/>
            <TextBlock Grid.Row="1" Grid.Column="4" Text="總訓練天數" Style="{StaticResource Subheading}"/>

            <DatePicker Grid.Row="2" Grid.Column="0" Style="{StaticResource CustomDatePicker}" SelectedDate="{Binding StartDate, Mode=TwoWay}">
                <DatePicker.CalendarStyle>
                    <Style TargetType="Calendar"
                           BasedOn="{StaticResource CustomCalendarStyle}">
                        <Setter Property="helpers:CalendarMarker.HasRecordDates"
                                Value="{Binding HasRecord}"/>
                        <Setter Property="helpers:CalendarMarker.SecondaryDate"
                                Value="{Binding EndDate}"/>
                    </Style>
                </DatePicker.CalendarStyle>
            </DatePicker>

            <DatePicker Grid.Row="2" Grid.Column="2" Style="{StaticResource CustomDatePicker}" SelectedDate="{Binding EndDate, Mode=TwoWay}">
                <DatePicker.CalendarStyle>
                    <Style TargetType="Calendar"
                           BasedOn="{StaticResource CustomCalendarStyle}">
                        <Setter Property="helpers:CalendarMarker.HasRecordDates"
                                Value="{Binding HasRecord}"/>
                        <Setter Property="helpers:CalendarMarker.SecondaryDate"
                                Value="{Binding StartDate}"/>
                    </Style>
                </DatePicker.CalendarStyle>
            </DatePicker>

            <Button Grid.Row="2" Grid.Column="3"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="10,10,20,10"
                    Width="20" Height="20"
                    Background="Transparent"
                    Command="{Binding Refresh}"
                    Style="{StaticResource PrimaryButton}">
                <Image Style="{StaticResource ImageStyle}" Source="{DynamicResource Refresh}"/>
            </Button>

            <TextBlock Grid.Row="2" Grid.Column="4" Style="{StaticResource Subheading}" Text="{Binding TotalDay}"/>

            <Rectangle Grid.Row="3" Grid.ColumnSpan="5" Style="{StaticResource DividerLine}"/>
        </Grid>

        <ScrollViewer x:Name="scroll_viewer" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Name="ChartContainer" Background="{DynamicResource BackgroundColor}" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ChartBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"  Text="每日各部位總訓練量(重量*組數*次數)" Style="{StaticResource Subheading}" HorizontalAlignment="Center"/>

                        <lvc:CartesianChart Grid.Row="1"
                                            Height="300"
                                            Series="{Binding SelectRecord}"
                                            XAxes="{Binding XAxes}"
                                            YAxes="{Binding YAxes}"
                                            DrawMarginFrame="{Binding DrawMarginFrame}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="0" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 自訂圖例 -->
                    <ItemsControl Grid.Row="0"
                                  ItemsSource="{Binding BodyPartLegendItems}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,15,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding IsVisible}"
                                              Command="{Binding DataContext.BodyPartToggleSeries, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding Name}"
                                              Style="{StaticResource LegendToggleButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Margin="0,0,5,0">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding Color}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource ItemsTxt}"/>
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Grid.Row="1" Content="儲存圖表" Style="{StaticResource PrimaryButton}" Margin="0,0,15,15" Click="Button_Click"/>
                </Grid>

                <Rectangle Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource DividerLine}"/>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource ChartBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"  Text="{Binding LineChartTitle}" Style="{StaticResource Subheading}" HorizontalAlignment="Center"/>

                        <lvc:CartesianChart Grid.Row="1"
                                            Height="300"
                                            Series="{Binding LineChartData}"
                                            XAxes="{Binding LineXAxes}"
                                            YAxes="{Binding LineYAxes}"
                                            DrawMarginFrame="{Binding LineDrawMarginFrame}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 自訂圖例 -->
                    <ItemsControl Grid.Row="0"
                                  ItemsSource="{Binding ExercisesLegendItems}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,15,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding IsVisible}"
                                              Command="{Binding DataContext.ExercisesToggleSeries,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding Name}"
                                              Style="{StaticResource LegendToggleButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- SVG 圖案 -->
                                        <Viewbox Width="10" Height="10"
                                                 Margin="0,0,5,0"
                                                 VerticalAlignment="Center">
                                            <Path Data="{Binding SvgPath}"
                                                  Stretch="Uniform"
                                                  StrokeThickness="2">
                                                <Path.Fill>
                                                    <SolidColorBrush Color="{Binding Color}"/>
                                                </Path.Fill>
                                            </Path>
                                        </Viewbox>
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource ItemsTxt}"/>
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Grid.Row="1" Content="重/組/次" Style="{StaticResource PrimaryButton}" Command="{Binding SwitchSheet}" Margin="0,0,15,15"/>
                </Grid>

                <!-- 空內容提示文字 -->
                <Border Grid.Row="2"
                        Grid.RowSpan="2"
                        Grid.ColumnSpan="2"
                        Margin="10"
                        Style="{StaticResource BorderStyle}"
                        Visibility="{Binding IsLineChartEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="請選擇部位"
                               Style="{StaticResource Hint}"/>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- 空內容提示文字(全部) -->
        <Border Grid.Row="2"
                Style="{StaticResource BorderStyle}"
                Visibility="{Binding IsDataEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="還沒有資料喔~"
                       Style="{StaticResource Hint}"/>
        </Border>
    </Grid>
</UserControl>
