<UserControl x:Class="SportsRecorder.Views.StatsStrengthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SportsRecorder.Views"
             xmlns:vm="clr-namespace:SportsRecorder.ViewModel"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1000">
    <UserControl.DataContext>
        <vm:StatsStrengthViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <sys:String x:Key="gray">#c3c3c3</sys:String>
        <sys:String x:Key="gray1">#a0a0a0</sys:String>
        <sys:String x:Key="gray2">#5a5a5a</sys:String>
        <sys:String x:Key="gray3">#3c3c3c</sys:String>
        <sys:String x:Key="gray4">#FFA1A7CC</sys:String>
    </UserControl.Resources>

    <Grid Background="#1A1D27">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Source="/Assets/Icons/bar_chart.png"
               Width="25" Height="25"
               Margin="5"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="統計分析 - 重量訓練" Style="{StaticResource Title}" />
            <Image Source="/Assets/Icons/fitness.png"
               Width="25" Height="25"
               Margin="5"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Rectangle Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource TitleDividerLine}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="起始日期" Style="{StaticResource Subheading}" Margin="10,10,10,10"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="結束日期" Style="{StaticResource Subheading}" Margin="10,10,10,10"/>

            <DatePicker Grid.Row="2" Grid.Column="0" Style="{StaticResource CustomDatePicker}" SelectedDate="{Binding StartDate, Mode=TwoWay}" Margin="10,0,0,0"/>
            <DatePicker Grid.Row="2" Grid.Column="1" Style="{StaticResource CustomDatePicker}" SelectedDate="{Binding EndDate, Mode=TwoWay}" Margin="10,0,0,0"/>

            <Rectangle Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource DividerLine}" Margin="10,5,10,5"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="每日各部位訓練總重量(重量*組數*次數)" Style="{StaticResource Subheading}" HorizontalAlignment="Center"/>

            <lvc:CartesianChart Grid.Row="1"
                                Series="{Binding SelectRecord}"
                                LegendPosition="Right"
                                LegendTextPaint="#FFA1A7CC"
                                Background="#FF3A3F54"
                                Margin="15,0,15,15"
                                DrawMarginFrame="{lvc:Frame Stroke={lvc:SolidColorPaint Color={StaticResource gray}, StrokeWidth=2}}">
                <lvc:CartesianChart.XAxes>
                    <lvc:AxesCollection>
                        <lvc:XamlDateTimeAxis
                            Interval="1.00:00:00"
                            DateFormatter="{Binding Formatter}"
                            LabelsPaint="{lvc:SolidColorPaint Color={StaticResource gray},FontFamily=DFKai-SB}"
                            SeparatorsPaint="#c8c8c8"
                            SeparatorsAtCenter="False"
                            TicksPaint="#232323"
                            TicksAtCenter="True"/>
                    </lvc:AxesCollection>
                </lvc:CartesianChart.XAxes>

                <lvc:CartesianChart.YAxes>
                    <lvc:AxesCollection>
                        <lvc:XamlAxis
                            NamePaint="{lvc:SolidColorPaint Color={StaticResource gray1},FontFamily=DFKai-SB}"
                            TextSize="18"
                            Labeler="{Binding YAxisLabeler}"
                            LabelsPaint="{lvc:SolidColorPaint Color={StaticResource gray},FontFamily=DFKai-SB}"
                            SeparatorsPaint="{lvc:SolidColorPaint Color={StaticResource gray}, StrokeWidth=1}"
                            SubseparatorsPaint="{lvc:SolidColorPaint Color={StaticResource gray2}, StrokeWidth=0.5}"
                            SubseparatorsCount="9"
                            ZeroPaint="{lvc:SolidColorPaint Color={StaticResource gray1}, StrokeWidth=2}"
                            TicksPaint="{lvc:SolidColorPaint Color={StaticResource gray}, StrokeWidth=1.5}"
                            SubticksPaint="{lvc:SolidColorPaint Color={StaticResource gray}, StrokeWidth=1}"/>
                    </lvc:AxesCollection>
                </lvc:CartesianChart.YAxes>
            </lvc:CartesianChart>
        </Grid>

        <Rectangle Grid.Row="3" Style="{StaticResource DividerLine}"/>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="每日各部位訓練重量變化" Style="{StaticResource Subheading}" HorizontalAlignment="Center"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <DataGrid Grid.Column="0"
                          ItemsSource="{Binding SelectSheetData}"
                          SelectedItem="{Binding SelectedSheetEntry}"
                          Style="{StaticResource ModernDataGrid}"
                          ColumnHeaderStyle="{StaticResource ModernHeader}"
                          CellStyle="{StaticResource ModernCell}"
                          RowStyle="{StaticResource ModernRow}"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          RowHeaderWidth="0"
                          Margin="10,0,10,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="部位" Width="auto" Binding="{Binding BodyPart}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <lvc:CartesianChart Grid.Column="1"
                                    Series="{Binding LineChartData}"
                                    LegendPosition="Right"
                                    LegendTextPaint="#FFA1A7CC"
                                    Background="#FF3A3F54"
                                    Margin="10,0,10,10"
                                    DrawMarginFrame="{lvc:Frame Stroke={lvc:SolidColorPaint Color={StaticResource gray}, StrokeWidth=2}}">
                    <lvc:CartesianChart.XAxes>
                        <lvc:AxesCollection>
                            <lvc:XamlDateTimeAxis
                                AxisName="{Binding NowBodyPart}"
                                NamePaint="{lvc:SolidColorPaint Color=#FFFFFFFF,FontFamily=DFKai-SB}"
                                TextSize="18"
                                Interval="1.00:00:00"
                                DateFormatter="{Binding Formatter}"
                                LabelsPaint="{lvc:SolidColorPaint Color={StaticResource gray},FontFamily=DFKai-SB}"/>
                        </lvc:AxesCollection>
                    </lvc:CartesianChart.XAxes>

                    <lvc:CartesianChart.YAxes>
                        <lvc:AxesCollection>
                            <lvc:XamlAxis
                                NamePaint="{lvc:SolidColorPaint Color={StaticResource gray1},FontFamily=DFKai-SB}"
                                TextSize="18"
                                Labeler="{Binding YAxisLabeler}"
                                LabelsPaint="{lvc:SolidColorPaint Color={StaticResource gray},FontFamily=DFKai-SB}"
                                SeparatorsPaint="{lvc:SolidColorPaint Color={StaticResource gray}, StrokeWidth=1}"
                                SubseparatorsPaint="{lvc:SolidColorPaint Color={StaticResource gray2}, StrokeWidth=0.5}"
                                SubseparatorsCount="9"
                                ZeroPaint="{lvc:SolidColorPaint Color={StaticResource gray1}, StrokeWidth=2}"
                                TicksPaint="{lvc:SolidColorPaint Color={StaticResource gray}, StrokeWidth=1.5}"
                                SubticksPaint="{lvc:SolidColorPaint Color={StaticResource gray}, StrokeWidth=1}"/>
                        </lvc:AxesCollection>
                    </lvc:CartesianChart.YAxes>
                </lvc:CartesianChart>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
