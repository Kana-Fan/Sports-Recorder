<UserControl x:Class="SportsRecorder.Views.TrainingJournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SportsRecorder.Views"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:s="clr-namespace:SportsRecorder"
             xmlns:helpers="clr-namespace:SportsRecorder.Helpers"
             xmlns:services="clr-namespace:SportsRecorder.Services"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800">
    <UserControl.Resources>
        <s:BodyPartToNamesConverter x:Key="BodyPartToNamesConverter"/>

        <!-- 有氧表格 -->
        <DataTemplate x:Key="CardioTemplate">
            <DataGrid ItemsSource="{Binding Cardios, Mode=TwoWay}"
                      Style="{StaticResource ModernDataGrid}"
                      ColumnHeaderStyle="{StaticResource ModernHeader}"
                      CellStyle="{StaticResource ModernCell}"
                      RowStyle="{StaticResource ModernRow}"
                      PreviewMouseWheel="mousewheel">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="運動" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <!-- 非編輯狀態：顯示文字 -->
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <!-- 編輯狀態：顯示 ComboBox -->
                            <DataTemplate>
                                <ComboBox SelectedItem="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding DataContext.CardioTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          Style="{StaticResource DarkComboBoxStyleBase}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <s:DataGridNumericColumn Header="距離(km)" Width="*" Binding="{Binding DistanceKm, Mode=TwoWay}" AllowDecimal="True" MaxLength="10"/>
                    <s:DataGridNumericColumn Header="時間(min)" Width="*" Binding="{Binding DurationMin, Mode=TwoWay}" MaxLength="4"/>
                    <DataGridTemplateColumn Header="操作" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="刪除"
                                    Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource PrimaryButton}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DataTemplate>

        <!-- 重訓表格，結構同上但欄位不同 -->
        <DataTemplate x:Key="StrengthTemplate">
            <DataGrid ItemsSource="{Binding Strengths, Mode=TwoWay}"
                      Style="{StaticResource ModernDataGrid}"
                      ColumnHeaderStyle="{StaticResource ModernHeader}"
                      CellStyle="{StaticResource ModernCell}"
                      RowStyle="{StaticResource ModernRow}"
                      PreviewMouseWheel="mousewheel">
                <DataGrid.Columns>
                    <!-- 部位欄位 -->
                    <DataGridTemplateColumn Header="部位" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <!--非編輯狀態：顯示文字-->
                            <DataTemplate>
                                <TextBlock Text="{Binding BodyPart}" VerticalAlignment="Center" Margin="4,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <!--編輯狀態：顯示 ComboBox-->
                            <DataTemplate>
                                <ComboBox SelectedItem="{Binding BodyPart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding DataContext.BodyTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          Style="{StaticResource DarkComboBoxStyleBase}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <!--運動名稱-->
                    <DataGridTemplateColumn Header="運動" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <!--非編輯狀態：顯示文字-->
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="4,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <!--編輯狀態：顯示 ComboBox-->
                            <DataTemplate>
                                <ComboBox SelectedItem="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkComboBoxStyleBase}">
                                    <ComboBox.ItemsSource>
                                        <MultiBinding Converter="{StaticResource BodyPartToNamesConverter}">
                                            <Binding Path="BodyPart"/>
                                            <Binding Path="DataContext.StrengthTypes"
                                                    RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </ComboBox.ItemsSource>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <s:DataGridNumericColumn Header="重量(kg)" Width="2*" Binding="{Binding WeightKg, Mode=TwoWay}" AllowDecimal="True" MaxLength="5"/>
                    <s:DataGridNumericColumn Header="組數" Width="*" Binding="{Binding Sets, Mode=TwoWay}" MaxLength="3"/>
                    <s:DataGridNumericColumn Header="次數" Width="*" Binding="{Binding Reps, Mode=TwoWay}" MaxLength="3"/>
                    <DataGridTemplateColumn Header="操作" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="刪除"
                                        Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource PrimaryButton}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid  Margin="0,0,0,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Source="{DynamicResource Journal}" Style="{StaticResource TitleImageStyle}"/>
            <TextBlock Text="訓練日誌" Style="{StaticResource Title}" />
        </StackPanel>

        <Rectangle Grid.Row="1" Style="{StaticResource TitleDividerLine}"/>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="日期" Style="{StaticResource Subheading}"/>
            <DatePicker Grid.Row="1" Grid.Column="0" SelectedDate="{Binding SelectedDate, Mode=TwoWay}" Style="{StaticResource CustomDatePicker}">
                <DatePicker.CalendarStyle>
                    <Style TargetType="Calendar"
                            BasedOn="{StaticResource CustomCalendarStyle}">
                        <Setter Property="helpers:CalendarMarker.HasRecordDates"
                                Value="{Binding HasRecord}"/>
                    </Style>
                </DatePicker.CalendarStyle>
            </DatePicker>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="運動類型" Style="{StaticResource Subheading}"/>
            <ComboBox Grid.Row="1" Grid.Column="2"
                      ItemsSource="{Binding ExerciseTypeOptions}"
                      SelectedValue="{Binding SelectedType, Mode=TwoWay}"
                      SelectedValuePath="Value"
                      DisplayMemberPath="DisplayName"
                      Style="{StaticResource DarkComboBoxStyle}"/>
            <!-- 只有有氧時才顯示 -->
            <StackPanel Grid.Row="0" Grid.Column="4" Grid.RowSpan="2">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <!-- 預設隱藏 -->
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCardio}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="總持續時間(min)" Style="{StaticResource Subheading}"/>

                <TextBlock Text="{Binding CardiosTotalDuration}" Style="{StaticResource Subheading}"/>
            </StackPanel>
        </Grid>

        <Rectangle Grid.Row="3" Style="{StaticResource DividerLine}"/>

        <TextBlock Grid.Row="4" Text="運動項目" Style="{StaticResource Subheading}" Margin="10,10,10,10"/>
        
        <!-- 依類型切換表格 -->
        <ScrollViewer x:Name="scroll_viewer" Grid.Row="5" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ContentControl Content="{Binding CurrentLog, Mode=TwoWay}" Margin="0,0,0,17">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCardio}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource CardioTemplate}"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding IsStrength}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource StrengthTemplate}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>

                <!-- 空內容提示文字 -->
                <Border Style="{StaticResource BorderStyle}"
                            Visibility="{Binding IsDataEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="今天還沒有記錄喔~"
                                   Style="{StaticResource Hint}"/>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- 底部按鈕列 -->
        <Grid  Grid.Row="6" Margin="10">
            <Button Content="儲存" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
            <Button Content="+" Command="{Binding AddEntryCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</UserControl>
