<UserControl x:Class="SportsRecorder.Views.StatsCardioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:local="clr-namespace:SportsRecorder.Views"
             xmlns:vm="clr-namespace:SportsRecorder.ViewModel"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <vm:StatsCardioViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <sys:String x:Key="gray">#c3c3c3</sys:String>
        <sys:String x:Key="gray1">#a0a0a0</sys:String>
        <sys:String x:Key="gray2">#5a5a5a</sys:String>
        <sys:String x:Key="gray3">#3c3c3c</sys:String>
    </UserControl.Resources>

    <Grid Background="#1A1D27">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Source="/Assets/Icons/bar_chart.png"
                   Width="25" Height="25"
                   Margin="5"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="統計圖表 - 有氧運動" Style="{StaticResource Title}" />
            <Image Source="/Assets/Icons/vo2_max.png"
                   Width="25" Height="25"
                   Margin="5"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Rectangle Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource TitleDividerLine}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="起始日期" Style="{StaticResource Subheading}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="結束日期" Style="{StaticResource Subheading}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="總運動時間(hrs)" Style="{StaticResource Subheading}"/>

            <DatePicker Grid.Row="2" Grid.Column="0" Style="{StaticResource CustomDatePicker}" SelectedDate="{Binding StartDate, Mode=TwoWay}"/>
            <DatePicker Grid.Row="2" Grid.Column="1" Style="{StaticResource CustomDatePicker}" SelectedDate="{Binding EndDate, Mode=TwoWay}"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Subheading}" Text="{Binding TotalTime}"/>

            <Rectangle Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource DividerLine}"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <lvc:CartesianChart Grid.Row="0" Grid.Column="0"
                                Series="{Binding SelectRecord}"
                                Background="#FF3A3F54"
                                Margin="15,0,15,15"
                                DrawMarginFrame="{lvc:Frame Stroke={lvc:SolidColorPaint Color={StaticResource gray}, StrokeWidth=2}}">
                <lvc:CartesianChart.Title>
                    <lvc:XamlDrawnLabelVisual Text="{Binding SheetTitle}" TextSize="20" Padding="15">
                        <lvc:XamlDrawnLabelVisual.Paint>
                            <lvc:SolidColorPaint Color="#FFA1A7CC" FontFamily="DFKai-SB" />
                        </lvc:XamlDrawnLabelVisual.Paint>
                    </lvc:XamlDrawnLabelVisual>
                </lvc:CartesianChart.Title>

                <lvc:CartesianChart.XAxes>
                    <lvc:AxesCollection>
                        <lvc:XamlDateTimeAxis
                            Interval="1.00:00:00"
                            DateFormatter="{Binding Formatter}"
                            LabelsPaint="{lvc:SolidColorPaint Color={StaticResource gray},FontFamily=DFKai-SB}"
                            SeparatorsPaint="#c8c8c8"
                            SeparatorsAtCenter="False"
                            TicksPaint="#232323"
                            TicksAtCenter="True"/>
                    </lvc:AxesCollection>
                </lvc:CartesianChart.XAxes>

                <lvc:CartesianChart.YAxes>
                    <lvc:AxesCollection>
                        <lvc:XamlAxis
                            NamePaint="{lvc:SolidColorPaint Color={StaticResource gray1},FontFamily=DFKai-SB}"
                            TextSize="18"
                            Labeler="{Binding YAxisLabeler}"
                            LabelsPaint="{lvc:SolidColorPaint Color={StaticResource gray},FontFamily=DFKai-SB}"
                            SeparatorsPaint="{lvc:SolidColorPaint Color={StaticResource gray}, StrokeWidth=1}"
                            SubseparatorsPaint="{lvc:SolidColorPaint Color={StaticResource gray2}, StrokeWidth=0.5}"
                            SubseparatorsCount="9"
                            ZeroPaint="{lvc:SolidColorPaint Color={StaticResource gray1}, StrokeWidth=2}"
                            TicksPaint="{lvc:SolidColorPaint Color={StaticResource gray}, StrokeWidth=1.5}"
                            SubticksPaint="{lvc:SolidColorPaint Color={StaticResource gray}, StrokeWidth=1}"
                            MinLimit="0"/>
                    </lvc:AxesCollection>
                </lvc:CartesianChart.YAxes>
            </lvc:CartesianChart>

            <Grid Grid.Row="0" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 自訂圖例 -->
                <ItemsControl Grid.Row="0"
                              ItemsSource="{Binding LegendItems}"
                              VerticalAlignment="Center"
                              Margin="0,0,15,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton IsChecked="{Binding IsVisible}"
                                          Command="{Binding DataContext.ToggleSeries,
                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          CommandParameter="{Binding Name}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Cursor="Hand"
                                          Margin="0,5">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Margin="0,0,5,0">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding Color}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="#FFA1A7CC"
                                               FontFamily="DFKai-SB"
                                               FontSize="20"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Grid.Row="1" Content="切換" Style="{StaticResource PrimaryButton}" Command="{Binding SwitchSheet}" Margin="0,0,17,15"/>
            </Grid>

            <Rectangle Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource DividerLine}"/>

            <Grid Grid.Row="2" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"  Text="各運動紀錄" Style="{StaticResource Subheading}" HorizontalAlignment="Center"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding SelectSheetData}"
                          Style="{StaticResource ModernDataGrid}"
                          ColumnHeaderStyle="{StaticResource ModernHeader}"
                          CellStyle="{StaticResource ModernCell}"
                          RowStyle="{StaticResource ModernRow}"
                          CanUserAddRows="False"
                          CanUserReorderColumns="False"
                          IsReadOnly="True"
                          RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="運動" Width="*" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="總距離(km)" Width="*" Binding="{Binding DistanceKm}"/>
                        <DataGridTextColumn Header="總次數" Width="*" Binding="{Binding Times}"/>
                        <DataGridTextColumn Header="總時間(min)" Width="*" Binding="{Binding DurationMin}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
