<UserControl x:Class="SportsRecorder.Views.StatsCardioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:local="clr-namespace:SportsRecorder.Views"
             xmlns:vm="clr-namespace:SportsRecorder.ViewModel"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:services="clr-namespace:SportsRecorder.Services"
             xmlns:helpers="clr-namespace:SportsRecorder.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="1000" d:DesignWidth="800">
    <Grid Margin="0,0,0,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Source="{DynamicResource Stats}" Style="{StaticResource TitleImageStyle}"/>
            <TextBlock Text="統計圖表 - 有氧運動" Style="{StaticResource Title}" />
            <Image Source="{DynamicResource Cardio}" Style="{StaticResource TitleImageStyle}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Rectangle Grid.Row="0" Grid.ColumnSpan="7" Style="{StaticResource TitleDividerLine}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="起始日期" Style="{StaticResource Subheading}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="結束日期" Style="{StaticResource Subheading}"/>
            <TextBlock Grid.Row="1" Grid.Column="4" Text="總運動天數" Style="{StaticResource Subheading}"/>
            <TextBlock Grid.Row="1" Grid.Column="6" Text="{Binding TotalTxt}" Style="{StaticResource Subheading}"/>

            <DatePicker Grid.Row="2" Grid.Column="0" Style="{StaticResource CustomDatePicker}" SelectedDate="{Binding StartDate, Mode=TwoWay}">
                <DatePicker.CalendarStyle>
                    <Style TargetType="Calendar"
                           BasedOn="{StaticResource CustomCalendarStyle}">
                        <Setter Property="helpers:CalendarMarker.HasRecordDates"
                                Value="{Binding HasRecord}"/>
                        <Setter Property="helpers:CalendarMarker.SecondaryDate"
                                Value="{Binding EndDate}"/>
                    </Style>
                </DatePicker.CalendarStyle>
            </DatePicker>

            <DatePicker Grid.Row="2" Grid.Column="2" Style="{StaticResource CustomDatePicker}" SelectedDate="{Binding EndDate, Mode=TwoWay}">
                <DatePicker.CalendarStyle>
                    <Style TargetType="Calendar"
                           BasedOn="{StaticResource CustomCalendarStyle}">
                        <Setter Property="helpers:CalendarMarker.HasRecordDates"
                                Value="{Binding HasRecord}"/>
                        <Setter Property="helpers:CalendarMarker.SecondaryDate"
                                Value="{Binding StartDate}"/>
                    </Style>
                </DatePicker.CalendarStyle>
            </DatePicker>

            <TextBlock Grid.Row="2" Grid.Column="4" Style="{StaticResource Subheading}" Text="{Binding TotalDay}"/>
            <TextBlock Grid.Row="2" Grid.Column="6" Style="{StaticResource Subheading}" Text="{Binding TotalData}"/>

            <Button Grid.Row="2" Grid.Column="3"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="10,10,20,10"
                    Width="20" Height="20"
                    Background="Transparent"
                    Command="{Binding Refresh}"
                    Style="{StaticResource PrimaryButton}" Cursor="Hand">
                <Image Style="{StaticResource ImageStyle}" Source="{DynamicResource Refresh}"/>
            </Button>

            <Rectangle Grid.Row="3" Grid.ColumnSpan="7" Style="{StaticResource DividerLine}"/>
        </Grid>

        <ScrollViewer x:Name="scroll_viewer" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Name="ChartContainer" Background="{DynamicResource BackgroundColor}" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ChartBorderStyle}">
                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"  Text="{Binding SheetTitle}" Style="{StaticResource Subheading}" HorizontalAlignment="Center"/>

                        <lvc:CartesianChart Grid.Row="1"
                                            MinHeight="300"
                                            Series="{Binding SelectRecord}"
                                            XAxes="{Binding XAxes}"
                                            YAxes="{Binding YAxes}"
                                            DrawMarginFrame="{Binding DrawMarginFrame}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="0" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 自訂圖例 -->
                    <ItemsControl Grid.Row="0"
                                  ItemsSource="{Binding LegendItems}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,15,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding IsVisible}"
                                              Command="{Binding DataContext.ToggleSeries,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding Name}"
                                              Style="{StaticResource LegendToggleButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Margin="0,0,5,0">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding Color}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource ItemsTxt}"/>
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Grid.Row="1" Content="時間/距離" Style="{StaticResource PrimaryButton}" Command="{Binding SwitchSheet}" Margin="0,0,15,15"/>
                    <Button Grid.Row="2" Content="儲存圖表" Style="{StaticResource PrimaryButton}" Margin="0,0,15,15" Click="Button_Click"/>
                </Grid>

                <Rectangle Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource DividerLine}"/>

                <Grid Grid.Row="2" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"  Text="各運動紀錄" Style="{StaticResource Subheading}" HorizontalAlignment="Center"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding SelectSheetData}"
                              Style="{StaticResource ModernDataGrid}"
                              ColumnHeaderStyle="{StaticResource ModernHeader}"
                              CellStyle="{StaticResource ModernCell}"
                              RowStyle="{StaticResource ModernRow}"
                              IsReadOnly="True"
                              PreviewMouseWheel="mousewheel">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="運動" Width="*" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="總距離(km)" Width="*" Binding="{Binding DistanceKm}"/>
                            <DataGridTextColumn Header="總時間(min)" Width="*" Binding="{Binding DurationMin}"/>
                            <DataGridTextColumn Header="總次數" Width="*" Binding="{Binding Times}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 空內容提示文字 -->
                <Border Grid.RowSpan="3"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource BorderStyle}"
                        Visibility="{Binding IsDataEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="目前無資料"
                               Style="{StaticResource Hint}"/>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
