<Window x:Class="SportsRecorder.Views.ShowSuccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SportsRecorder.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight">
    <Border Background="{DynamicResource BackgroundColor}" CornerRadius="12"
        BorderBrush="{DynamicResource TextColor}" BorderThickness="1">
        <StackPanel Margin="24" VerticalAlignment="Center">
            <TextBlock Text="╰（￣▽￣）╭" Style="{StaticResource Title}" HorizontalAlignment="Center" />

            <TextBlock x:Name="MessageText" Style="{StaticResource Subheading}"  HorizontalAlignment="Center" MaxWidth="500" TextWrapping="Wrap"/>

            <Button x:Name="ConfirmButton" Content="確認" Margin="10" Style="{StaticResource PrimaryButton}" Click="ConfirmButton_Click" />
        </StackPanel>
    </Border>
</Window>
