<UserControl x:Class="SportsRecorder.Views.DataManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SportsRecorder.Views"
             xmlns:vm="clr-namespace:SportsRecorder.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <vm:DataManagementViewModel/>
    </UserControl.DataContext>

    <Grid Background="#1A1D27">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Source="/Assets/Icons/folder.png"
                   Width="25" Height="25"
                   Margin="5"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="資料管理" Style="{StaticResource Title}" />
        </StackPanel>

        <Rectangle Grid.Row="1" Style="{StaticResource TitleDividerLine}"/>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Image Source="/Assets/Icons/upload.png"
                       Width="25" Height="25"
                       Margin="20,5,5,5"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="匯入 (可匯入 Json 與 Excel )" Style="{StaticResource Subheading}" />
            </StackPanel>

            <TextBlock Grid.Row="1" Margin="30,20,5,20" Text="{Binding FileName}" Style="{StaticResource Subheading}" FontSize="20" TextWrapping="WrapWithOverflow"/>

            <StackPanel  Grid.Row="2" Orientation="Horizontal">
                <Button Content="選擇檔案位置" Width="100" Margin="20,5,5,5" Command="{Binding OpenFileCommand}" Style="{StaticResource PrimaryButton}"/>
                <Button Content="匯入" Width="100" Margin="30,5,5,5" Command="{Binding UpLoadFileCommand}" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>

        <Rectangle Grid.Row="3" Style="{StaticResource DividerLine}"/>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Image Source="/Assets/Icons/download.png"
               Width="25" Height="25"
               Margin="20,5,5,5"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="匯出 (可匯出 Json 與 Excel )" Style="{StaticResource Subheading}" />
            </StackPanel>

            <Button Grid.Row="1" Content="匯出檔案" Width="100" Margin="20,20,5,5" Command="{Binding DownLoadFileCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
        </Grid>
    </Grid>
</UserControl>
