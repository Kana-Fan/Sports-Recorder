<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:helpers="clr-namespace:SportsRecorder.Helpers">
    <FontFamily x:Key="LINESeedTW_TTF_Rg">/Assets/Fonts/#LINE Seed TW_TTF Regular</FontFamily>

    <!--Border-->
    <Style x:Key="BorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BackgroundColor}"/>
        <Setter Property="CornerRadius" Value="20"/>
    </Style>

    <Style x:Key="PageBorderStyle" TargetType="Border" BasedOn="{StaticResource BorderStyle}">
        <Setter Property="Margin" Value="5"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="Black"/>
    </Style>

    <Style x:Key="ChartBorderStyle" TargetType="Border" BasedOn="{StaticResource PageBorderStyle}">
        <Setter Property="Background" Value="{DynamicResource ChartBackgroundColor}"/>
        <Setter Property="Margin" Value="15"/>
    </Style>

    <!--圖-->
    <Style TargetType="lvc:CartesianChart">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!--圖像-->
    <Style x:Key="ImageStyle" TargetType="Image">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="MenuImageStyle" TargetType="Image" BasedOn="{StaticResource ImageStyle}">
        <Setter Property="Margin" Value="7,0,10,0"/>
    </Style>

    <Style x:Key="TitleImageStyle" TargetType="Image" BasedOn="{StaticResource ImageStyle}">
        <Setter Property="Width" Value="25"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="Margin" Value="10,5,5,5"/>
    </Style>

    <!-- TreeView 樣式：移除邊距與邊框-->
    <Style x:Key="TreeView" TargetType="TreeView">
        <Setter Property="Background" Value="{DynamicResource BackgroundColor}"/>
        <Setter Property="Padding" Value="0,8,0,8"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- TreeViewItem 樣式 -->
    <Style x:Key="TreeViewItem" TargetType="TreeViewItem">
        <Setter Property="FontFamily" Value="{StaticResource LINESeedTW_TTF_Rg}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsExpanded" Value="True"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <!-- 節點列 -->
                        <Grid x:Name="ItemRow" MinHeight="40" Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左側指示條 -->
                            <Rectangle x:Name="SelectionBar"
                                   Grid.Column="0"
                                   Fill="#FF1E9BFA"
                                   RadiusX="2" RadiusY="2"
                                   Opacity="0" Height="20"/>

                            <!-- 懸停/選取背景 -->
                            <Border x:Name="HoverBg"
                                Grid.Column="1"
                                Background="Transparent"
                                CornerRadius="0,6,6,0"
                                Margin="0,2,8,2"/>

                            <!-- 內容：縮排 + 箭頭 + 文字 -->
                            <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                                <!-- Header 內容 -->
                                <ContentPresenter x:Name="PART_Header"
                                              ContentSource="Header"
                                              VerticalAlignment="Center"
                                              Margin="5,0,10,0"/>

                                <!-- 展開箭頭 -->
                                <TextBlock x:Name="ExpandArrow"
                                       Text="›"
                                       FontSize="18"
                                       FontFamily="Segoe UI"
                                       Foreground="{DynamicResource TextColor}"
                                       VerticalAlignment="Center"
                                       Width="18"
                                       TextAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="ArrowRotate" Angle="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- 子項目 -->
                        <ItemsPresenter x:Name="ItemsHost" Margin="20,0,0,0" Visibility="Collapsed"/>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <!-- 沒有子項目時隱藏箭頭 -->
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="ExpandArrow" Property="Visibility" Value="Hidden"/>
                        </Trigger>

                        <!-- 確保子項目可以收合 -->
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- 展開動畫 -->
                        <Trigger Property="IsExpanded" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ArrowRotate"
                                                     Storyboard.TargetProperty="Angle"
                                                     To="90" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ArrowRotate"
                                                     Storyboard.TargetProperty="Angle"
                                                     To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- 懸停 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SelectionBar" Property="Opacity" Value="0.4"/>
                            <Setter TargetName="HoverBg" Property="Background" Value="{DynamicResource SelectedBackgroundColor}"/>
                        </Trigger>

                        <!-- 選取 -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectionBar" Property="Opacity" Value="1"/>
                            <Setter TargetName="HoverBg" Property="Background" Value="{DynamicResource SelectedBackgroundColor}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectedTextColor}"/>
                        </Trigger>

                        <DataTrigger Binding="{Binding DataContext.IsNavCollapsed,
                                 RelativeSource={RelativeSource AncestorType=TreeView}}"
                                 Value="True">
                            <Setter TargetName="ExpandArrow"  Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ItemsHost"    Property="Visibility" Value="Collapsed"/>
                            <Setter Property="IsExpanded"     Value="False"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--文字樣式-->
    <Style x:Key="Txt" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource  LINESeedTW_TTF_Rg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="Margin" Value="10" />
    </Style>

    <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource Txt}">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="25" />
    </Style>

    <Style x:Key="Subheading" TargetType="TextBlock" BasedOn="{StaticResource Txt}">
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Subheading}">
        <Setter Property="Foreground" Value="{DynamicResource HintTextColor}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ItemsTxt" TargetType="TextBlock" BasedOn="{StaticResource Subheading}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="SearchTextBox" TargetType="TextBox">
        <Setter Property="Width" Value="150"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontFamily" Value="{StaticResource LINESeedTW_TTF_Rg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="CaretBrush" Value="#FF484E67"/>
        <Setter Property="Template" >
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBoxBase}">
                    <Grid>
                        <Border x:Name="border"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0"
                                      Style="{StaticResource ImageStyle}"
                                      Margin="5"
                                      Source="{DynamicResource Search}"/>
                                <ScrollViewer Grid.Column="1"
                                              x:Name="PART_ContentHost"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Width="100"
                                              Margin="10 0 0 0"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 日期選擇 -->
    <Style x:Key="CustomDatePicker" TargetType="DatePicker">
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="FontFamily" Value="{StaticResource LINESeedTW_TTF_Rg}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0" >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 文字輸入框，移除邊框 -->
                            <DatePickerTextBox x:Name="PART_TextBox"
                                               Grid.Column="0"
                                               Foreground="{DynamicResource TextColor}"
                                               Focusable="{TemplateBinding Focusable}"
                                               HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                               VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                                <DatePickerTextBox.Style>
                                    <Style TargetType="DatePickerTextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DatePickerTextBox">
                                                    <Border BorderBrush="#FF3A3F54"
                                                            BorderThickness="0"
                                                            Background="Transparent">
                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      Margin="2,0" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DatePickerTextBox.Style>
                            </DatePickerTextBox>

                            <!-- 自訂日曆按鈕 -->
                            <Button x:Name="PART_Button"
                                    Grid.Column="1"
                                    Focusable="False"
                                    Width="28"
                                    Height="28"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource LegendMouseOver}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource LegendPressed}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>

                                <!-- 自訂圖示 -->
                                <Image Source="{DynamicResource Date}" Style="{StaticResource ImageStyle}"/>
                            </Button>

                            <!-- 彈出的日曆 Popup -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=PART_TextBox}"
                                   StaysOpen="False"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGrid -->
    <Style x:Key="ModernDataGrid" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="RowHeight" Value="50"/>
        <Setter Property="ColumnHeaderHeight" Value="40"/>
        <Setter Property="FontFamily" Value="{StaticResource LINESeedTW_TTF_Rg}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
        <Setter Property="BorderBrush" Value="Black"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource SheetBackgroundColor}"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <!-- 標題 -->
    <Style x:Key="ModernHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource SheetBackgroundColor}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="BorderThickness" Value="0,1,1,1"/>
        <Setter Property="BorderBrush" Value="Black"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!--表格內文-->
    <Style x:Key="ModernCell" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Black"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                Padding="4">
                        <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--表格Row-->
    <Style x:Key="ModernRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource RowBackgroundColor}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Style.Triggers>
            <!-- 滑鼠移過時的背景色 -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF4662D4" />
            </Trigger>
            <!-- 當列被選取時的變化 -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#FF3453D2" />
                <Setter Property="FontWeight" Value="Bold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--按鈕-->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundColor}"/>
        <Setter Property="FontFamily" Value="{StaticResource LINESeedTW_TTF_Rg}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Width" Value="80"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- 滑鼠移入 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border"
                                    Property="Background"
                                    Value="#357ABD"/>
                        </Trigger>

                        <!-- 按下 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border"
                                    Property="Background"
                                    Value="#2C5F99"/>
                        </Trigger>

                        <!-- 停用 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border"
                                    Property="Opacity"
                                    Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MenuButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Margin" Value="10" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="LegendToggleButton" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderThickness="0"
                        CornerRadius="4"
                        Padding="6,3">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                Property="Background"
                                Value="{DynamicResource LegendMouseOver}"/>
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource LegendPressed}"/>
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Opacity" Value="0.7"/>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource LegendMouseOver}"/>
                        </MultiTrigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource LegendPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--ComboBox-->
    <Style x:Key="DarkComboBoxStyleBase" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource BackgroundColor}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="BorderBrush" Value="#FF7A7C8C"/>
        <Setter Property="FontFamily" Value="{StaticResource LINESeedTW_TTF_Rg}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Foreground="{TemplateBinding Foreground}"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Padding="{TemplateBinding Padding}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter
                                                Grid.Column="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="6,0"/>
                                            <!-- 下拉箭頭 -->
                                            <Path
                                                Grid.Column="1"
                                                Data="M 0 0 L 4 4 L 8 0"
                                                Stroke="#A1A7CC"
                                                StrokeThickness="1.5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter
                            IsHitTestVisible="False"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            VerticalAlignment="Center"
                            Margin="8,0,24,0"/>

                        <Popup
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            AllowsTransparency="True"
                            Focusable="False">
                            <Border
                                Background="{DynamicResource BackgroundColor}"
                                BorderBrush="#3A3F5C"
                                BorderThickness="1"
                                CornerRadius="4"
                                MinWidth="{TemplateBinding ActualWidth}">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!-- 每個下拉項目的樣式 -->
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2A2F45"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#2A2F45"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyleBase}">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Width" Value="150"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontSize" Value="20"/>
    </Style>

    <!--分隔線-->
    <Style x:Key="DividerLine" TargetType="Rectangle">
        <Setter Property="Margin" Value="10,5,10,5"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Fill" Value="{DynamicResource LineFill}"/>
    </Style>

    <Style x:Key="TitleDividerLine" TargetType="Rectangle" BasedOn="{StaticResource DividerLine}">
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="Height" Value="2"/>
    </Style>

    <!-- ScrollBar Arrow Button -->
    <Style x:Key="ScrollBarArrowButton" TargetType="RepeatButton">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FF9D9D9D"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#FF9D9D9D"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Transparent Track Button (clicking track area) -->
    <Style x:Key="ScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollBar Thumb -->
    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <!-- Border Background => thumb顏色 -->
                    <Border x:Name="ThumbBorder"
                            Background="#FF9D9D9D"
                            CornerRadius="3"
                            Margin="4,0"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#6B7A8D"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#7E8FA3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vertical ScrollBar -->
    <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
        <!-- Grid Background 軌道背景色 -->
        <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="18"/>
            </Grid.RowDefinitions>

            <!-- Up Arrow -->
            <RepeatButton Grid.Row="0"
                          Style="{StaticResource ScrollBarArrowButton}"
                          Command="ScrollBar.LineUpCommand">
                <Path Data="M 0,4 L 4,0 L 8,4"
                      Stroke="#8899AA"
                      StrokeThickness="1.5"
                      Fill="Transparent"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </RepeatButton>

            <!-- Track -->
            <Track Grid.Row="1"
                   x:Name="PART_Track"
                   IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                                  Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBarThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                                  Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>

            <!-- Down Arrow -->
            <RepeatButton Grid.Row="2"
                          Style="{StaticResource ScrollBarArrowButton}"
                          Command="ScrollBar.LineDownCommand">
                <!-- Path Stroke 箭頭顏色 -->
                <Path Data="M 0,0 L 4,4 L 8,0"
                      Stroke="#8899AA"
                      StrokeThickness="1.5"
                      Fill="Transparent"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </RepeatButton>
        </Grid>
    </ControlTemplate>

    <!-- ScrollBar Style -->
    <Style x:Key="DarkScrollBarStyle" TargetType="ScrollBar">
        <!-- Width 整個 scrollbar 寬度 -->
        <Setter Property="Width" Value="18"/>
        <Setter Property="MinWidth" Value="18"/>
        <Setter Property="Background" Value="#1E2733"/>
        <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
    </Style>

    <!-- ScrollViewer Style -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ScrollContentPresenter Grid.Column="0"/>

                        <ScrollBar Grid.Column="1"
                                   x:Name="PART_VerticalScrollBar"
                                   Style="{StaticResource DarkScrollBarStyle}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--CalendarDayButton-->
    <Style x:Key="MarkedCalendarDayButtonStyle" TargetType="CalendarDayButton">
        <Setter Property="Width"      Value="34"/>
        <Setter Property="Height"     Value="34"/>
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource CalText}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Grid>
                        <!-- Hover 背景 -->
                        <Ellipse x:Name="HoverBg"
                             Fill="{DynamicResource CalHover}"
                             Opacity="0"/>
                        <!-- 選取背景 -->
                        <Ellipse x:Name="SelectedBg"
                             Fill="{DynamicResource CalAccent}"
                             Opacity="0"/>

                        <!-- 日期數字 -->
                        <TextBlock x:Name="DayText"
                               Text="{TemplateBinding Content}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{TemplateBinding Foreground}"
                               FontSize="{TemplateBinding FontSize}"
                               FontWeight="{TemplateBinding FontWeight}"/>

                        <!-- 訓練圓點 -->
                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,3">
                            <Ellipse x:Name="CardioDot"
                                 Width="4" Height="4" Margin="1,0"
                                 Fill="#FF43A047"
                                 Visibility="Collapsed"/>
                            <Ellipse x:Name="StrengthDot"
                                 Width="4" Height="4" Margin="1,0"
                                 Fill="#EF5350"
                                 Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverBg" Property="Opacity" Value="1"/>
                        </Trigger>
                        <!-- 選取 -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedBg" Property="Opacity" Value="1"/>
                            <Setter TargetName="HoverBg"    Property="Opacity" Value="0"/>
                        </Trigger>
                        <!-- 今日（未選取時加淡框） -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsToday"    Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SelectedBg" Property="Opacity" Value="0.35"/>
                        </MultiTrigger>
                        <!-- 非當月 -->
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource CalTextMuted}"/>
                        </Trigger>
                        <!-- 停用 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource CalTextMuted}"/>
                        </Trigger>
                        <!-- 有氧資料 -->
                        <DataTrigger Binding="{Binding Path=(helpers:CalendarMarker.HasCardio),
                                           RelativeSource={RelativeSource Self}}"
                                     Value="True">
                            <Setter TargetName="CardioDot" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <!-- 重訓資料 -->
                        <DataTrigger Binding="{Binding Path=(helpers:CalendarMarker.HasStrength),
                                           RelativeSource={RelativeSource Self}}"
                                     Value="True">
                            <Setter TargetName="StrengthDot" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--CalendarButton（月/年選擇視圖的格子）-->
    <Style x:Key="CustomCalendarButtonStyle" TargetType="CalendarButton">
        <Setter Property="Width"      Value="58"/>
        <Setter Property="Height"     Value="46"/>
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource CalText}"/>
        <Setter Property="Margin"     Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Grid>
                        <Rectangle x:Name="SelectedBg"
                                   Fill="{DynamicResource CalAccent}"
                                   RadiusX="6" RadiusY="6"
                                   Opacity="0"/>
                        <Rectangle x:Name="HoverBg"
                                   Fill="{DynamicResource CalHover}"
                                   RadiusX="6" RadiusY="6"
                                   Opacity="0"/>
                        <TextBlock Text="{TemplateBinding Content}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"/>
                        <Ellipse x:Name="RecordDot"
                                Width="5" Height="5"
                                Fill="{DynamicResource CalAccent}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,4"
                                Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverBg" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="SelectedBg" Property="Opacity" Value="1"/>
                            <Setter TargetName="HoverBg"    Property="Opacity" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource CalTextMuted}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Path=(helpers:CalendarMarker.HasAnyRecord),
                                       RelativeSource={RelativeSource Self}}"
                             Value="True">
                            <Setter TargetName="RecordDot" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <!-- 選取時圓點改白色，避免和背景衝突 -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=(helpers:CalendarMarker.HasAnyRecord),
                                            RelativeSource={RelativeSource Self}}"
                                           Value="True"/>
                                <Condition Binding="{Binding HasSelectedDays,
                                            RelativeSource={RelativeSource Self}}"
                                           Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="RecordDot" Property="Fill" Value="White"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 前後月份按鈕 -->
    <Style x:Key="CalNavButtonStyle" TargetType="Button">
        <Setter Property="Width"      Value="30"/>
        <Setter Property="Height"     Value="30"/>
        <Setter Property="Background" Value="{DynamicResource CalAccent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="BtnBg"
                                 Fill="{TemplateBinding Background}"/>
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,4"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBg" Property="Fill" Value="#FF6E6B"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBg" Property="Fill" Value="#C62828"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CalendarItem（整個日曆的骨架） -->
    <Style x:Key="CustomCalendarItemStyle" TargetType="CalendarItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="DayTitleTemplate">
                            <TextBlock Text="{Binding}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource CalHeaderText}"
                                       HorizontalAlignment="Center"
                                       Width="34" Height="26"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ControlTemplate.Resources>

                    <Border Background="{DynamicResource CalBg}"
                            BorderBrush="Black"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="14,12,14,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 標題列 -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        x:Name="PART_HeaderButton"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource CalText}"
                                        FontSize="18"
                                        FontWeight="Bold">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <TextBlock Text="{TemplateBinding Content}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   FontWeight="{TemplateBinding FontWeight}"
                                                   VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Grid.Column="1"
                                        x:Name="PART_PreviousButton"
                                        Style="{StaticResource CalNavButtonStyle}"
                                        Content="&#8249;"
                                        FontSize="20"/>

                                <Button Grid.Column="3"
                                        x:Name="PART_NextButton"
                                        Style="{StaticResource CalNavButtonStyle}"
                                        Content="&#8250;"
                                        FontSize="20"/>
                            </Grid>

                            <!-- 月曆視圖 -->
                            <Grid x:Name="PART_MonthView"
                                  Grid.Row="2"
                                  Visibility="Visible"
                                  HorizontalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                            </Grid>

                            <!-- 年份/十年視圖 -->
                            <Grid x:Name="PART_YearView"
                                  Grid.Row="2"
                                  Visibility="Hidden"
                                  HorizontalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- DataTrigger 綁定 Calendar.DisplayMode -->
                    <ControlTemplate.Triggers>
                        <DataTrigger Value="Year">
                            <DataTrigger.Binding>
                                <Binding Path="DisplayMode">
                                    <Binding.RelativeSource>
                                        <RelativeSource Mode="FindAncestor"
                                                AncestorType="{x:Type Calendar}"/>
                                    </Binding.RelativeSource>
                                </Binding>
                            </DataTrigger.Binding>
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_YearView"  Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Value="Decade">
                            <DataTrigger.Binding>
                                <Binding Path="DisplayMode">
                                    <Binding.RelativeSource>
                                        <RelativeSource Mode="FindAncestor"
                                                AncestorType="{x:Type Calendar}"/>
                                    </Binding.RelativeSource>
                                </Binding>
                            </DataTrigger.Binding>
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_YearView"  Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Calendar（最外層，套用所有子樣式）-->
    <Style x:Key="CustomCalendarStyle" TargetType="Calendar">
        <Setter Property="Background"           Value="Transparent"/>
        <Setter Property="BorderThickness"      Value="0"/>
        <Setter Property="CalendarItemStyle"    Value="{StaticResource CustomCalendarItemStyle}"/>
        <Setter Property="CalendarDayButtonStyle"
            Value="{StaticResource MarkedCalendarDayButtonStyle}"/>
        <Setter Property="CalendarButtonStyle"
            Value="{StaticResource CustomCalendarButtonStyle}"/>
    </Style>
</ResourceDictionary>
