<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--圖表相關顏色-->
    <sys:String x:Key="gray">#6b6b6b</sys:String>
    <sys:String x:Key="gray1">#FF000000</sys:String>
    <sys:String x:Key="gray2">#c2c2c2</sys:String>
    <sys:String x:Key="gray3">#e8e8e8</sys:String>
    <sys:String x:Key="gray4">#FF000000</sys:String>

    <!--背景顏色-->
    <SolidColorBrush x:Key="BackgroundColor" Color="#FFFDFDFD"/>
    <SolidColorBrush x:Key="NavBackgroundColor" Color="#FFEDEDED"/>
    <SolidColorBrush x:Key="SelectedBackgroundColor" Color="#E6E8F4"/>
    <SolidColorBrush x:Key="MouseOverBackgroundColor" Color="#EAECF6"/>
    <SolidColorBrush x:Key="SheetBackgroundColor" Color="#FFFAFAFA"/>
    <SolidColorBrush x:Key="RowBackgroundColor" Color="#FFECECEC"/>
    <SolidColorBrush x:Key="ButtonBackgroundColor" Color="#FFFEFEFE"/>
    <SolidColorBrush x:Key="LineFill" Color="Black"/>
    <SolidColorBrush x:Key="ChartBackgroundColor" Color="White"/>

    <!--文字顏色-->
    <SolidColorBrush x:Key="TextColor" Color="Black"/>
    <SolidColorBrush x:Key="SelectedTextColor" Color="#1A1D27"/>
    <SolidColorBrush x:Key="HintTextColor" Color="#2A2D40"/>

    <!--圖片路徑-->
    <BitmapImage x:Key="Journal"  UriSource="/Assets/Icons/LightMode/contract_edit.png"/>
    <BitmapImage x:Key="Exercise" UriSource="/Assets/Icons/LightMode/database.png"/>
    <BitmapImage x:Key="Cardio"  UriSource="/Assets/Icons/LightMode/vo2_max.png"/>
    <BitmapImage x:Key="Strength" UriSource="/Assets/Icons/LightMode/fitness.png"/>
    <BitmapImage x:Key="Stats"  UriSource="/Assets/Icons/LightMode/bar_chart.png"/>
    <BitmapImage x:Key="Data" UriSource="/Assets/Icons/LightMode/folder.png"/>
    <BitmapImage x:Key="Download"  UriSource="/Assets/Icons/LightMode/download.png" />
    <BitmapImage x:Key="Upload" UriSource="/Assets/Icons/LightMode/upload.png" />
    <BitmapImage x:Key="Search"  UriSource="/Assets/Icons/LightMode/search.png"/>
    <BitmapImage x:Key="Menu"  UriSource="/Assets/Icons/LightMode/menu.png"/>
    <BitmapImage x:Key="Mode" UriSource="/Assets/Icons/LightMode/dark_mode.png"/>
    <BitmapImage x:Key="Refresh" UriSource="/Assets/Icons/LightMode/refresh.png"/>
    <BitmapImage x:Key="Date" UriSource="/Assets/Icons/LightMode/date.png"/>
</ResourceDictionary>
