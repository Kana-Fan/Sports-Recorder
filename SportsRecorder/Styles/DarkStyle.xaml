<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--日歷顏色定義-->
    <SolidColorBrush x:Key="CalBg"          Color="#FF202020"/>
    <SolidColorBrush x:Key="CalAccent"      Color="#FF5A5A5A"/>
    <SolidColorBrush x:Key="CalText"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CalTextMuted"   Color="#55FFFFFF"/>
    <SolidColorBrush x:Key="CalHeaderText"  Color="#88FFFFFF"/>
    <SolidColorBrush x:Key="CalHover"       Color="#FF3E3E3E"/>

    <!--背景顏色-->
    <SolidColorBrush x:Key="BackgroundColor" Color="#FF272727"/>
    <SolidColorBrush x:Key="NavBackgroundColor" Color="#FF202020"/>
    <SolidColorBrush x:Key="SelectedBackgroundColor" Color="#FF2D2D2D"/>
    <SolidColorBrush x:Key="MouseOverBackgroundColor" Color="#22253A"/>
    <SolidColorBrush x:Key="SheetBackgroundColor" Color="#FF2C2C2C"/>
    <SolidColorBrush x:Key="RowBackgroundColor" Color="#FF3E3E3E"/>
    <SolidColorBrush x:Key="ButtonBackgroundColor" Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="LineFill" Color="White"/>
    <SolidColorBrush x:Key="ChartBackgroundColor" Color="#FF393939"/>
    <SolidColorBrush x:Key="LegendMouseOver" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="LegendPressed" Color="#44FFFFFF"/>

    <!--文字顏色-->
    <SolidColorBrush x:Key="TextColor" Color="White"/>
    <SolidColorBrush x:Key="SelectedTextColor" Color="White"/>
    <SolidColorBrush x:Key="HintTextColor" Color="White"/>

    <!--圖片路徑-->
    <BitmapImage x:Key="Journal"  UriSource="/Assets/Icons/DarkMode/contract_edit.png"/>
    <BitmapImage x:Key="Exercise" UriSource="/Assets/Icons/DarkMode/database.png"/>
    <BitmapImage x:Key="Cardio"  UriSource="/Assets/Icons/DarkMode/vo2_max.png"/>
    <BitmapImage x:Key="Strength" UriSource="/Assets/Icons/DarkMode/fitness.png"/>
    <BitmapImage x:Key="Stats"  UriSource="/Assets/Icons/DarkMode/bar_chart.png"/>
    <BitmapImage x:Key="Data" UriSource="/Assets/Icons/DarkMode/folder.png"/>
    <BitmapImage x:Key="Download"  UriSource="/Assets/Icons/DarkMode/download.png" />
    <BitmapImage x:Key="Upload" UriSource="/Assets/Icons/DarkMode/upload.png" />
    <BitmapImage x:Key="Search"  UriSource="/Assets/Icons/DarkMode/search.png"/>
    <BitmapImage x:Key="Menu"  UriSource="/Assets/Icons/DarkMode/menu.png"/>
    <BitmapImage x:Key="Mode" UriSource="/Assets/Icons/DarkMode/light_mode.png"/>
    <BitmapImage x:Key="Refresh" UriSource="/Assets/Icons/DarkMode/refresh.png"/>
    <BitmapImage x:Key="Date" UriSource="/Assets/Icons/DarkMode/date.png"/>
</ResourceDictionary>
