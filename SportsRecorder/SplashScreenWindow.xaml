<Window x:Class="SportsRecorder.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SportsRecorder"
        mc:Ignorable="d"
        Title="SplashScreenWindow"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" Background="{DynamicResource BackgroundColor}">
    <Border Background="{DynamicResource BackgroundColor}"
            CornerRadius="12"
            BorderBrush="{DynamicResource TextColor}"
            BorderThickness="1">

        <TextBlock Name="_text"
                   Text="Sports Recorder"
                   FontSize="24"
                   Foreground="White"
                   FontFamily="Comic Sans MS"
                   Margin="20"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Border>
</Window>
