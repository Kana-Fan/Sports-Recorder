<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="Txt" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="DFKai-SB"/>
        <Setter Property="Margin" Value="10" />
    </Style>

    <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource Txt}">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="35" />
    </Style>

    <Style x:Key="Subheading" TargetType="TextBlock" BasedOn="{StaticResource Txt}">
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style x:Key="Contents" TargetType="TextBox">
        <Setter Property="FontFamily" Value="DFKai-SB"/>
        <Setter Property="Margin" Value="10" />
        <Setter Property="FontSize" Value="25" />
    </Style>

    <!-- 日期選擇 -->
    <Style x:Key="CustomDatePicker" TargetType="DatePicker">
        <Setter Property="FontFamily" Value="DFKai-SB"/>
        <Setter Property="FontSize" Value="25"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10"/>
    </Style>

    <!--ComboBox-->
    <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="DFKai-SB"/>
        <Setter Property="FontSize" Value="25"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Width" Value="150"/>
        <Setter Property="Height" Value="35"/>
    </Style>
</ResourceDictionary>