<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="Txt" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="DFKai-SB"/>
        <Setter Property="Foreground" Value="#FFA1A7CC"/>
        <Setter Property="Margin" Value="10" />
    </Style>

    <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource Txt}">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="25" />
    </Style>

    <Style x:Key="Subheading" TargetType="TextBlock" BasedOn="{StaticResource Txt}">
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style x:Key="Contents" TargetType="TextBox">
        <Setter Property="FontFamily" Value="DFKai-SB"/>
        <Setter Property="Foreground" Value="#FFA1A7CC"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#FF484E67"/>
        <Setter Property="Margin" Value="10" />
        <Setter Property="FontSize" Value="25" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF484E67"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SearchTextBox" TargetType="TextBox">
        <Setter Property="Width" Value="150"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontFamily" Value="DFKai-SB"/>
        <Setter Property="Foreground" Value="#FFA1A7CC"/>
        <Setter Property="CaretBrush" Value="#FF484E67"/>
        <Setter Property="Template" >
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBoxBase}">
                    <Grid>
                        <Border x:Name="border"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0"
                                       Source="/Assets/Icons/search.png"
                                       Width="25" Height="25"
                                       Margin="5"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <ScrollViewer Grid.Column="1"
                                              x:Name="PART_ContentHost"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Width="100"
                                              Margin="10 0 0 0"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 日期選擇 -->
    <Style x:Key="CustomDatePicker" TargetType="DatePicker">
        <Setter Property="Foreground" Value="#FFA1A7CC"/>
        <Setter Property="FontFamily" Value="DFKai-SB"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0" >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 文字輸入框，移除邊框 -->
                            <DatePickerTextBox
                                x:Name="PART_TextBox"
                                Grid.Column="0"
                                Foreground="#FFA1A7CC"
                                Focusable="{TemplateBinding Focusable}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                                <DatePickerTextBox.Style>
                                    <Style TargetType="DatePickerTextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DatePickerTextBox">
                                                    <Border BorderBrush="#FF3A3F54"
                                                            BorderThickness="0"
                                                            Background="Transparent">
                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      Margin="2,0" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DatePickerTextBox.Style>
                            </DatePickerTextBox>

                            <!-- 自訂日曆按鈕 -->
                            <Button
                                x:Name="PART_Button"
                                Grid.Column="1"
                                Focusable="False"
                                Width="28"
                                Height="28"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#EEEEEE"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#DDDDDD"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>

                                <!-- 自訂圖示：使用 Path 畫日曆 -->
                                <Path Width="16" Height="16"
                                      Stretch="Uniform"
                                      Fill="#FFA1A7CC"
                                      Data="M19 4h-1V2h-2v2H8V2H6v2H5C3.9 4 3 4.9 3 6v14
                                            c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2z
                                            m0 16H5V10h14v10zm0-12H5V6h14v2z
                                            M7 12h2v2H7zm4 0h2v2h-2zm4 0h2v2h-2z"/>
                            </Button>

                            <!-- 彈出的日曆 Popup -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=PART_TextBox}"
                                   StaysOpen="False"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 共用 DataGrid -->
    <Style x:Key="ModernDataGrid" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="RowHeight" Value="40"/>
        <Setter Property="ColumnHeaderHeight" Value="40"/>
        <Setter Property="FontFamily" Value="DFKai-SB"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Margin" Value="10" />
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="AlternatingRowBackground" Value="#FF3A3F54"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    </Style>

    <!-- 標題 -->
    <Style x:Key="ModernHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#FF3A3F54"/>
        <Setter Property="Foreground" Value="#FFA1A7CC"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Black"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!--表格內文-->
    <Style x:Key="ModernCell" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Black"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                Padding="4">
                        <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--表格Row-->
    <Style x:Key="ModernRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="#FF484E67"/>
        <Setter Property="Foreground" Value="#FFA1A7CC"/>
        <Style.Triggers>
            <!-- 滑鼠移過時的背景色 -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF4662D4" />
            </Trigger>
            <!-- 當列被選取時的變化 -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#FF3453D2" />
                <Setter Property="FontWeight" Value="Bold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--按鈕-->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FFA1A7CC"/>
        <Setter Property="Background" Value="#FF3A3F54"/>
        <Setter Property="FontFamily" Value="DFKai-SB"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Width" Value="80"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- 滑鼠移入 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border"
                                    Property="Background"
                                    Value="#357ABD"/>
                        </Trigger>

                        <!-- 按下 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border"
                                    Property="Background"
                                    Value="#2C5F99"/>
                        </Trigger>

                        <!-- 停用 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border"
                                    Property="Opacity"
                                    Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--ComboBox-->
    <Style x:Key="DarkComboBoxStyleBase" TargetType="ComboBox">
        <Setter Property="Background" Value="#1A1D27"/>
        <Setter Property="Foreground" Value="#A1A7CC"/>
        <Setter Property="BorderBrush" Value="#FF7A7C8C"/>
        <Setter Property="FontFamily" Value="DFKai-SB"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Foreground="{TemplateBinding Foreground}"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Padding="{TemplateBinding Padding}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter
                                                Grid.Column="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="6,0"/>
                                            <!-- 下拉箭頭 -->
                                            <Path
                                                Grid.Column="1"
                                                Data="M 0 0 L 4 4 L 8 0"
                                                Stroke="#A1A7CC"
                                                StrokeThickness="1.5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter
                            IsHitTestVisible="False"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            VerticalAlignment="Center"
                            Margin="8,0,24,0"/>

                        <Popup
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            AllowsTransparency="True"
                            Focusable="False">
                            <Border
                                Background="#1A1D27"
                                BorderBrush="#3A3F5C"
                                BorderThickness="1"
                                CornerRadius="4"
                                MinWidth="{TemplateBinding ActualWidth}">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!-- 每個下拉項目的樣式 -->
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="#A1A7CC"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2A2F45"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#2A2F45"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyleBase}">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Width" Value="150"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="FontSize" Value="20"/>
    </Style>

    <Style x:Key="DividerLine" TargetType="Rectangle">
        <Setter Property="Margin" Value="10,5,10,5"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Fill" Value="#FF7A7C8C"/>
    </Style>

    <Style x:Key="TitleDividerLine" TargetType="Rectangle" BasedOn="{StaticResource DividerLine}">
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="Height" Value="2"/>
    </Style>
</ResourceDictionary>
