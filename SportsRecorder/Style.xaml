<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="LINESeedTW_TTF_Rg">/Assets/Fonts/#LINE Seed TW_TTF Regular</FontFamily>

    <!-- TreeView 樣式：移除邊距與邊框-->
    <Style TargetType="TreeView">
        <Setter Property="Background" Value="#1A1D27" />
        <Setter Property="Padding" Value="0,8,0,8"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- TreeViewItem 樣式 -->
    <Style TargetType="TreeViewItem">
        <Setter Property="FontFamily" Value="{StaticResource LINESeedTW_TTF_Rg}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#FFA1A7CC"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsExpanded" Value="True"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <!-- 節點列 -->
                        <Grid x:Name="ItemRow" MinHeight="40" Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左側指示條 -->
                            <Rectangle x:Name="SelectionBar"
                                   Grid.Column="0"
                                   Fill="#6C63FF"
                                   RadiusX="2" RadiusY="2"
                                   Opacity="0"/>

                            <!-- 懸停/選取背景 -->
                            <Border x:Name="HoverBg"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Background="Transparent"
                                CornerRadius="0,6,6,0"
                                Margin="0,2,8,2"/>

                            <!-- 內容：縮排 + 箭頭 + 文字 -->
                            <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                                <!-- Header 內容 -->
                                <ContentPresenter x:Name="PART_Header"
                                              ContentSource="Header"
                                              VerticalAlignment="Center"
                                              Margin="5,0,10,0"/>
                                <!-- 展開箭頭 -->
                                <TextBlock x:Name="ExpandArrow"
                                       Text="›"
                                       FontSize="18"
                                       FontFamily="Segoe UI"
                                       Foreground="#FF7E83A7"
                                       VerticalAlignment="Center"
                                       Width="18"
                                       TextAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="ArrowRotate" Angle="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- 子項目 -->
                        <ItemsPresenter x:Name="ItemsHost" Margin="20,0,0,0" Visibility="Collapsed"/>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <!-- 沒有子項目時隱藏箭頭 -->
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="ExpandArrow" Property="Visibility" Value="Hidden"/>
                        </Trigger>

                        <!-- 確保子項目可以收合 -->
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- 展開動畫 -->
                        <Trigger Property="IsExpanded" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ArrowRotate"
                                                     Storyboard.TargetProperty="Angle"
                                                     To="90" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ArrowRotate"
                                                     Storyboard.TargetProperty="Angle"
                                                     To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- 懸停 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverBg" Property="Background" Value="#22253A"/>
                            <Setter TargetName="SelectionBar" Property="Opacity" Value="0.4"/>
                        </Trigger>

                        <!-- 選取 -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="HoverBg" Property="Background" Value="#252836"/>
                            <Setter TargetName="SelectionBar" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Txt" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource  LINESeedTW_TTF_Rg}"/>
        <Setter Property="Foreground" Value="#FFA1A7CC"/>
        <Setter Property="Margin" Value="10" />
    </Style>

    <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource Txt}">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="25" />
    </Style>

    <Style x:Key="Subheading" TargetType="TextBlock" BasedOn="{StaticResource Txt}">
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style x:Key="Contents" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource LINESeedTW_TTF_Rg}"/>
        <Setter Property="Foreground" Value="#FFA1A7CC"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#FF484E67"/>
        <Setter Property="Margin" Value="10" />
        <Setter Property="FontSize" Value="25" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF484E67"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SearchTextBox" TargetType="TextBox">
        <Setter Property="Width" Value="150"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontFamily" Value="{StaticResource LINESeedTW_TTF_Rg}"/>
        <Setter Property="Foreground" Value="#FFA1A7CC"/>
        <Setter Property="CaretBrush" Value="#FF484E67"/>
        <Setter Property="Template" >
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBoxBase}">
                    <Grid>
                        <Border x:Name="border"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0"
                                       Source="/Assets/Icons/search.png"
                                       Width="25" Height="25"
                                       Margin="5"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <ScrollViewer Grid.Column="1"
                                              x:Name="PART_ContentHost"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Width="100"
                                              Margin="10 0 0 0"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 日期選擇 -->
    <Style x:Key="CustomDatePicker" TargetType="DatePicker">
        <Setter Property="Foreground" Value="#FFA1A7CC"/>
        <Setter Property="FontFamily" Value="{StaticResource LINESeedTW_TTF_Rg}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0" >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 文字輸入框，移除邊框 -->
                            <DatePickerTextBox
                                x:Name="PART_TextBox"
                                Grid.Column="0"
                                Foreground="#FFA1A7CC"
                                Focusable="{TemplateBinding Focusable}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                                <DatePickerTextBox.Style>
                                    <Style TargetType="DatePickerTextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DatePickerTextBox">
                                                    <Border BorderBrush="#FF3A3F54"
                                                            BorderThickness="0"
                                                            Background="Transparent">
                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      Margin="2,0" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DatePickerTextBox.Style>
                            </DatePickerTextBox>

                            <!-- 自訂日曆按鈕 -->
                            <Button
                                x:Name="PART_Button"
                                Grid.Column="1"
                                Focusable="False"
                                Width="28"
                                Height="28"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#EEEEEE"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#DDDDDD"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>

                                <!-- 自訂圖示：使用 Path 畫日曆 -->
                                <Path Width="16" Height="16"
                                      Stretch="Uniform"
                                      Fill="#FFA1A7CC"
                                      Data="M19 4h-1V2h-2v2H8V2H6v2H5C3.9 4 3 4.9 3 6v14
                                            c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2z
                                            m0 16H5V10h14v10zm0-12H5V6h14v2z
                                            M7 12h2v2H7zm4 0h2v2h-2zm4 0h2v2h-2z"/>
                            </Button>

                            <!-- 彈出的日曆 Popup -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=PART_TextBox}"
                                   StaysOpen="False"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 共用 DataGrid -->
    <!-- 移除 Row Header -->
    <Style TargetType="DataGridRowHeader">
        <Setter Property="Width" Value="0"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
    
    <Style x:Key="ModernDataGrid" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="RowHeight" Value="50"/>
        <Setter Property="ColumnHeaderHeight" Value="40"/>
        <Setter Property="FontFamily" Value="{StaticResource LINESeedTW_TTF_Rg}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Margin" Value="10" />
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="AlternatingRowBackground" Value="#FF3A3F54"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    </Style>

    <!-- 標題 -->
    <Style x:Key="ModernHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#FF3A3F54"/>
        <Setter Property="Foreground" Value="#FFA1A7CC"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Black"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!--表格內文-->
    <Style x:Key="ModernCell" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Black"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                Padding="4">
                        <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--表格Row-->
    <Style x:Key="ModernRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="#FF484E67"/>
        <Setter Property="Foreground" Value="#FFA1A7CC"/>
        <Style.Triggers>
            <!-- 滑鼠移過時的背景色 -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF4662D4" />
            </Trigger>
            <!-- 當列被選取時的變化 -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#FF3453D2" />
                <Setter Property="FontWeight" Value="Bold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--按鈕-->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FFA1A7CC"/>
        <Setter Property="Background" Value="#FF3A3F54"/>
        <Setter Property="FontFamily" Value="{StaticResource LINESeedTW_TTF_Rg}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Width" Value="80"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- 滑鼠移入 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border"
                                    Property="Background"
                                    Value="#357ABD"/>
                        </Trigger>

                        <!-- 按下 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border"
                                    Property="Background"
                                    Value="#2C5F99"/>
                        </Trigger>

                        <!-- 停用 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border"
                                    Property="Opacity"
                                    Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--ComboBox-->
    <Style x:Key="DarkComboBoxStyleBase" TargetType="ComboBox">
        <Setter Property="Background" Value="#1A1D27"/>
        <Setter Property="Foreground" Value="#A1A7CC"/>
        <Setter Property="BorderBrush" Value="#FF7A7C8C"/>
        <Setter Property="FontFamily" Value="{StaticResource LINESeedTW_TTF_Rg}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Foreground="{TemplateBinding Foreground}"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Padding="{TemplateBinding Padding}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter
                                                Grid.Column="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="6,0"/>
                                            <!-- 下拉箭頭 -->
                                            <Path
                                                Grid.Column="1"
                                                Data="M 0 0 L 4 4 L 8 0"
                                                Stroke="#A1A7CC"
                                                StrokeThickness="1.5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter
                            IsHitTestVisible="False"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            VerticalAlignment="Center"
                            Margin="8,0,24,0"/>

                        <Popup
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            AllowsTransparency="True"
                            Focusable="False">
                            <Border
                                Background="#1A1D27"
                                BorderBrush="#3A3F5C"
                                BorderThickness="1"
                                CornerRadius="4"
                                MinWidth="{TemplateBinding ActualWidth}">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!-- 每個下拉項目的樣式 -->
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="#A1A7CC"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2A2F45"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#2A2F45"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyleBase}">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Width" Value="150"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontSize" Value="20"/>
    </Style>

    <Style x:Key="DividerLine" TargetType="Rectangle">
        <Setter Property="Margin" Value="10,5,10,5"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Fill" Value="#FF7A7C8C"/>
    </Style>

    <Style x:Key="TitleDividerLine" TargetType="Rectangle" BasedOn="{StaticResource DividerLine}">
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="Height" Value="2"/>
    </Style>

    <!-- ScrollBar Arrow Button -->
    <Style x:Key="ScrollBarArrowButton" TargetType="RepeatButton">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2E3A4A"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#3A4A5A"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Transparent Track Button (clicking track area) -->
    <Style x:Key="ScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollBar Thumb -->
    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <!-- Border Background => thumb顏色 -->
                    <Border x:Name="ThumbBorder"
                            Background="#4A5568"
                            CornerRadius="3"
                            Margin="4,0"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#6B7A8D"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#7E8FA3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vertical ScrollBar -->
    <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
        <!-- Grid Background 軌道背景色 -->
        <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="18"/>
            </Grid.RowDefinitions>

            <!-- Up Arrow -->
            <RepeatButton Grid.Row="0"
                          Style="{StaticResource ScrollBarArrowButton}"
                          Command="ScrollBar.LineUpCommand">
                <Path Data="M 0,4 L 4,0 L 8,4"
                      Stroke="#8899AA"
                      StrokeThickness="1.5"
                      Fill="Transparent"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </RepeatButton>

            <!-- Track -->
            <Track Grid.Row="1"
                   x:Name="PART_Track"
                   IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                                  Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBarThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                                  Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>

            <!-- Down Arrow -->
            <RepeatButton Grid.Row="2"
                          Style="{StaticResource ScrollBarArrowButton}"
                          Command="ScrollBar.LineDownCommand">
                <!-- Path Stroke 箭頭顏色 -->
                <Path Data="M 0,0 L 4,4 L 8,0"
                      Stroke="#8899AA"
                      StrokeThickness="1.5"
                      Fill="Transparent"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </RepeatButton>
        </Grid>
    </ControlTemplate>

    <!-- ScrollBar Style -->
    <Style x:Key="DarkScrollBarStyle" TargetType="ScrollBar">
        <!-- Width 整個 scrollbar 寬度 -->
        <Setter Property="Width" Value="18"/>
        <Setter Property="MinWidth" Value="18"/>
        <Setter Property="Background" Value="#1E2733"/>
        <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
    </Style>

    <!-- ScrollViewer Style -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ScrollContentPresenter Grid.Column="0"/>

                        <ScrollBar Grid.Column="1"
                                   x:Name="PART_VerticalScrollBar"
                                   Style="{StaticResource DarkScrollBarStyle}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
